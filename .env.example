# Required dashboard passphrase. Replace with a long, unique value in private .env.
PASS_DASHBOAR=replace-with-a-long-unique-dashboard-passphrase

# Used only when ALBUM_ORIGIN is configured. Must differ from PASS_DASHBOAR.
PASS_ALBUM=

# Admin origin. Leave empty for dashboard-only local loopback access.
# Dashboard-only deployments may also use the existing HTTPS wildcard form.
# Album-enabled deployments require an exact HTTPS origin.
PANEL_ORIGIN=

# Optional exact HTTPS origin that enables the separately authenticated album.
# Must use a different hostname from PANEL_ORIGIN.
ALBUM_ORIGIN=

# Loopback Bun listener port.
PANEL_PORT=3008
