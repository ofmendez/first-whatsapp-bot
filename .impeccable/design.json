      "html": "<a class=\"ds-album-action\" href=\"#recuerdos\">Explorar recuerdos</a>",
      "css": ".ds-album-action{min-height:54px;padding:0 23px;display:inline-flex;align-items:center;justify-content:center;gap:22px;border:1px solid #c29e4e;border-radius:3px;background:#d6b25e;color:#3a2f3f;font:700 .875rem/1.2 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;box-shadow:0 7px 18px rgba(58,47,63,.12);text-decoration:none}.ds-album-action:hover{background:#c29e4e;transform:translateY(-2px)}.ds-album-action:focus-visible{outline:3px solid #6a4c7d;outline-offset:4px}"
