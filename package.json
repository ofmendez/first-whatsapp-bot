{
  "name": "whatsapp-bot",
  "module": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run build && bun run index.js",
    "start:prod": "bun run index.js",
    "preview:local": "bun run scripts/local-preview-proxy.js",
    "build": "astro build",
    "lint": "oxlint --config .oxlintrc.json index.js \"src/**/*.js\" \"src/**/*.astro\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format": "oxfmt --config .oxfmtrc.json index.js \"src/**/*.{astro,js,css}\" \"tests/**/*.js\" \"scripts/**/*.js\" astro.config.mjs package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --config .oxfmtrc.json --check index.js \"src/**/*.{astro,js,css}\" \"tests/**/*.js\" \"scripts/**/*.js\" astro.config.mjs package.json .oxlintrc.json .oxfmtrc.json",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "latest",
    "@types/qrcode": "1.5.6",
    "astro": "7.4.11",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "1.5.4"
  }
}
