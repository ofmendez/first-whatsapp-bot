---
import MessageComposer from "@/src/components/MessageComposer.astro";
---

<section
  class="activity-column flex min-h-135 min-w-0 flex-col overflow-hidden rounded-xl border border-line bg-panel max-wide:min-h-120 max-mobile:min-h-0"
  aria-labelledby="activity-heading"
>
  <div class="section-heading activity-heading flex items-start justify-between gap-4.5 border-b border-[#d8e0e2] px-6 pt-5.75 pb-4.5 max-mobile:px-4.25 max-mobile:pt-5 max-mobile:pb-3.75">
    <div>
      <h2 id="activity-heading">Live activity</h2>
      <p>New direct-chat text and images from this process</p>
    </div>
    <span class="activity-count pt-1" id="activity-count">
      0 EVENTS
    </span>
  </div>

  <div
    class="activity-list min-h-0 flex-1 overflow-auto"
    id="activity-list"
    aria-live="polite"
    aria-relevant="additions text"
  >
    <div
      class="empty-state flex min-h-77.5 flex-col items-center justify-center px-6.5 py-11 text-center max-mobile:min-h-41.25 max-mobile:px-4.5 max-mobile:py-6"
      id="empty-state"
    >
      <span
        class="empty-line relative mb-5.75 h-px w-[min(260px,80%)] bg-[#b8c6ca]"
        aria-hidden="true"
      ></span>
      <h3>Waiting for a session</h3>
      <p>
        New text and image events appear here while connected. No history is requested or restored.
      </p>
    </div>
  </div>

  <MessageComposer />
</section>
