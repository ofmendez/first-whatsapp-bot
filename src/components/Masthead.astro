<header class="masthead flex min-h-16 items-center justify-between gap-6 px-[clamp(20px,5vw,76px)] max-mobile:min-h-14.5 max-mobile:px-4.5">
  <a
    class="wordmark inline-flex items-center gap-3"
    href="/"
    aria-label="WhatsApp session control home"
  >
    <span class="wordmark-mark grid size-7.75 place-items-center" aria-hidden="true">
      <svg class="size-full" viewBox="0 0 32 32" fill="none">
        <path
          d="M6 8.5A3.5 3.5 0 0 1 9.5 5h13A3.5 3.5 0 0 1 26 8.5v9a3.5 3.5 0 0 1-3.5 3.5h-6l-5.25 5v-5H9.5A3.5 3.5 0 0 1 6 17.5v-9Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path
          d="M11 11h10M11 15h6"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span>SESSION CONTROL</span>
  </a>
  <div class="local-marker inline-flex items-center gap-2.25 max-mobile:gap-1.5">
    <span class="local-dot size-2 rounded-full" aria-hidden="true"></span>
    <span class="max-mobile:hidden">OWNER · PRIVATE</span>
    <button
      class="dashboard-sign-out-button"
      id="dashboard-sign-out-button"
      type="button"
      aria-label="Sign out of the dashboard without ending WhatsApp"
      title="Signs out of this dashboard without ending WhatsApp"
    >
      Sign out
    </button>
  </div>
</header>
