<form
  class="send-form border-t border-[#d8e0e2] bg-[#f4f7f7] px-6 pt-4.75 pb-5.25 max-mobile:p-4.25"
  id="send-form"
>
  <label class="mb-px block text-[14px] font-[740]" for="message-input">
    Message yourself
  </label>
  <p class="send-hint mb-2.75">Sent only to the linked account’s own chat.</p>
  <div class="send-controls flex items-stretch gap-2.5 max-mobile:flex-col">
    <textarea
      id="message-input"
      name="text"
      rows="2"
      maxlength="4096"
      placeholder="Write a message…"
      class="min-w-0 flex-1 resize-y rounded-md border border-[#aebdc1] bg-white px-3 py-2.75 leading-[1.4] text-ink disabled:bg-[#e9eeee]"
      required
      disabled
    ></textarea>
    <button
      class="button button-send inline-flex min-h-11.5 min-w-37.5 cursor-pointer items-center justify-center gap-2.5 rounded-[7px] border border-transparent bg-brand px-4 py-2.75 text-center font-[680] text-white transition-[background-color,border-color,transform] duration-140 hover:bg-brand-hover disabled:cursor-not-allowed disabled:opacity-[.52] motion-reduce:transition-none max-mobile:w-full"
      id="send-button"
      type="submit"
      disabled
    >
      <span>Send to self</span>
      <svg class="size-4.75" aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path
          d="M3.5 10h12m-5-5 5 5-5 5"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
  <p class="send-result mt-2 min-h-4.25" id="send-result" role="status" aria-live="polite"></p>
</form>
