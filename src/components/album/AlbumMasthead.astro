<header class="album-masthead">
  <a class="album-wordmark" href="/" aria-label="Nuestro álbum, inicio">
    <span class="album-mark" aria-hidden="true">
      <svg viewBox="0 0 38 38" fill="none">
        <path d="M8 8.5h17.5A3.5 3.5 0 0 1 29 12v20H11.5A3.5 3.5 0 0 1 8 28.5z" />
        <path d="M8 12H5v16.5A3.5 3.5 0 0 0 8.5 32H29" />
        <path d="M13 15h10M13 19h8" />
      </svg>
    </span>
    <span>Nuestro álbum</span>
  </a>

  <nav class="album-navigation" aria-label="Navegación del álbum">
    <a class="album-nav-link" href="#recuerdos">
      Recuerdos
    </a>
    <button class="album-signout" type="button" data-album-signout>
      Salir
    </button>
    <span
      class="album-signout-feedback"
      data-album-signout-status
      role="status"
      aria-live="polite"
      hidden
    ></span>
  </nav>
</header>
