---
import ControlPanelLayout from "@/src/layouts/ControlPanelLayout.astro";
---

<ControlPanelLayout title="Dashboard sign in">
  <header class="login-masthead">
    <a class="wordmark" href="/login/" aria-label="Session control sign in">
      <span class="wordmark-mark grid size-7.75 place-items-center" aria-hidden="true">
        <svg class="size-full" viewBox="0 0 32 32" fill="none">
          <path
            d="M6 8.5A3.5 3.5 0 0 1 9.5 5h13A3.5 3.5 0 0 1 26 8.5v9a3.5 3.5 0 0 1-3.5 3.5h-6l-5.25 5v-5H9.5A3.5 3.5 0 0 1 6 17.5v-9Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="M11 11h10M11 15h6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </span>
      <span>SESSION CONTROL</span>
    </a>
    <span class="login-access-label">OWNER ACCESS</span>
  </header>

  <main class="login-main">
    <section class="login-panel" aria-labelledby="login-heading">
      <h1 id="login-heading">Sign in to the dashboard</h1>
      <p class="login-copy">Enter the dashboard passphrase to continue.</p>

      <form class="login-form" id="login-form" method="post" action="/api/auth/login">
        <label class="login-label" for="passphrase">
          Dashboard passphrase
        </label>
        <input
          class="login-input"
          id="passphrase"
          name="passphrase"
          type="password"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          maxlength="1024"
          required
        />
        <button class="login-submit" id="login-submit" type="submit">
          Continue
        </button>
        <p class="login-feedback" id="login-feedback" role="status" aria-live="polite" hidden></p>
      </form>
    </section>
  </main>

  <script>
    import "@/src/scripts/login.js";
  </script>
</ControlPanelLayout>
